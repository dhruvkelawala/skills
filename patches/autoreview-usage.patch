+def record_claude_usage(args: argparse.Namespace, stdout: str, *, completed: bool = True) -> None:
+    attempts = getattr(args, "review_usage", None)
+    if attempts is None:
+        args.review_usage = attempts = []
+    try:
+        decoded = json.loads(stdout)
+        events = decoded if isinstance(decoded, list) else [decoded]
+    except (ValueError, RecursionError):
+        events = []
+        for line in stdout.splitlines():
+            try:
+                events.append(json.loads(line))
+            except (ValueError, RecursionError):
+                pass
+    latest = None
+    terminal = False
+    for event in events:
+        if not isinstance(event, dict) or event.get("type") != "result":
+            continue
+        usage = event.get("usage")
+        fields = ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
+        terminal = False
+        if isinstance(usage, dict) and all(type(usage.get(key)) is int and usage[key] >= 0 for key in fields):
+            latest = {key: usage[key] for key in fields}
+            cache = usage.get("cache_creation", {})
+            if isinstance(cache, dict):
+                for key in ("ephemeral_5m_input_tokens", "ephemeral_1h_input_tokens"):
+                    if type(cache.get(key)) is int and cache[key] >= 0:
+                        latest[key] = cache[key]
+            terminal = not event.get("is_error", False)
+    attempts.append({"tokens": latest, "complete": completed and terminal})
+
